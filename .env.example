# Shared secret Chord sends as "Authorization: Bearer <token>"
MCP_AUTH_TOKEN=

# Paystack TEST secret key (sk_test_...)
PAYSTACK_SECRET_KEY=

# ID of the "Jeffworldwide inventory" Google Sheet (the long string in its URL)
GOOGLE_SHEET_ID=

# Service account with Editor access to the sheet.
# Keep the key on one line with literal \n between lines, wrapped in double quotes.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional, local only
PORT=3000
