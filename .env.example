# Shared secret Chord sends as "Authorization: Bearer <token>"
MCP_AUTH_TOKEN=

# Paystack TEST secret key (sk_test_...)
PAYSTACK_SECRET_KEY=

# ID of the "Jeffworldwide inventory" Google Sheet (the long string in its URL)
GOOGLE_SHEET_ID=

# Service account with Editor access to the sheet.
# Keep the key on one line with literal \n between lines, wrapped in double quotes.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional, local only
PORT=3000

# WhatsApp alert to the team through Twilio, sent by request_callback.
# Without the first four, requests are still recorded but no alert is sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The WhatsApp sender and the team number to alert, e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=
ALERT_WHATSAPP_TO=
# Optional: an approved WhatsApp template (HX...) with one variable, {{1}}.
# If empty, or if Twilio rejects it, a plain text message is sent instead.
TWILIO_CONTENT_SID=
